---
# Copy to site.yml next to this file in environments/<env>/inventory/group_vars/dsgrow/ (gitignored) and fill in your
# addresses. Everything else in the inventory refers to these values, so no address lives in git.
dsgrow_site:
  run_host: 192.0.2.10                  # the host running the dsgrow-eda containers; VCF Ops posts alerts to it
  fa_url:                               # by dsgrow_flasharrays[].key
    fa-a: https://192.0.2.20
  vcenter_ip:                           # by dsgrow_vcenters[].key: what VCF Ops may send as the adapter instance
    vc01: 198.51.100.21
  demo_net:                             # the demo VM's static address on dsgrow_demo.portgroup (demo only)
    ip: 203.0.113.21
    prefix: 24
    gateway: 203.0.113.1
    dns: [203.0.113.1]
    ntp: [203.0.113.1]
  # router: 192.0.2.1                   # only if lab.yml's ssh_jump refers to it
