# Copy to .env on the run host (gitignored). Read by tools/*.sh and by docker compose.
#
# The inventory to use: environments/<DSGROW_ENV>/inventory/ (hosts.yml, group_vars/dsgrow/*.yml including the gitignored site.yml)
DSGROW_ENV=example
#
# Optional: a directory mounted read-only at /lab in the tool containers, holding what environments/<env>/inventory/.../lab.yml
# points to: the lab's admin-credentials vault, SSH keys, the Ubuntu OVA. Leave empty if lab.yml points into .state/.
DSGROW_LAB_DIR=
# Optional: the vault password file for the lab's vault, as a path under /lab (or /work/.state/...)
DSGROW_LAB_VAULT_PASS=
