# The demo guest (demo/init.yml), cloud-init network config v2: one vmxnet3 NIC on
# dd.portgroup, a static address (site.yml demo_net), its gateway and DNS. Matched by name (ens192, the first
# vmxnet3 slot of the Ubuntu cloud image).
version: 2
ethernets:
  eth0:
    match:
      name: ens192
    dhcp4: false
    dhcp6: false
    accept-ra: false
    addresses: [{{ dd.ip }}/{{ dd.prefix }}]
    routes:
      - to: default
        via: {{ dd.gateway }}
    nameservers:
      addresses: {{ dd.dns | to_json }}
      search: [{{ dd.dns_zone }}]
