# The demo guest (demo/init.yml), as nested-vcf's lab guests (roles/router_seed templates/guest): one vmxnet3 NIC on
# the app port group, a static address, the router as gateway and DNS. Matched by name (ens192, the first vmxnet3
# slot, measured there 2026-11-02).
version: 2
ethernets:
  eth0:
    match:
      name: ens192
    dhcp4: false
    dhcp6: false
    accept-ra: false
    addresses: [{{ dd.ip }}/{{ dd.prefix }}]
    routes:
      - to: default
        via: {{ dd.gateway }}
    nameservers:
      addresses: {{ dd.dns | to_json }}
      search: [{{ dd.dns_zone }}]
